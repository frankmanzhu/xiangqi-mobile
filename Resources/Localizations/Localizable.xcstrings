        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "人机对弈完全在本机运行，使用内置的 Pikafish 引擎与 NNUE 网络，无需账号或网络连接。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
