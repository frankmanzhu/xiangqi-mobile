    "licenses.ccpd.note": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Xiangqi Mobile decodes the source text, converts Chinese notation to UCI, validates move legality, and indexes accepted records for offline study. Invalid or ambiguous records are excluded."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Xiangqi Mobile 解码源文本，将中文记谱转换为 UCI，校验着法合法性，并为离线研习建立索引。无效或有歧义的棋谱已被排除。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Xiangqi Mobile 解碼原始文字，將中文記譜轉換為 UCI，驗證著法合法性，並為離線研習建立索引。無效或有歧義的棋譜已被排除。"
          }
        }
      }
    },
