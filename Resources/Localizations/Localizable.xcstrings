    "rules.advisor": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Moves one point diagonally inside the palace."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在九宫内斜走一格。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在九宮內斜走一格。"
          }
        }
      }
    },
    "rules.cannon": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Moves like a chariot, but captures by jumping exactly one intervening piece."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "走法同车，吃子时必须隔一个棋子跳过。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "走法同車，吃子時必須隔一個棋子跳過。"
          }
        }
      }
    },
    "rules.chariot": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Moves any distance along a clear file or rank."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "沿无阻挡的直线或横线任意距离移动。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "沿無阻擋的直線或橫線任意距離移動。"
          }
        }
      }
    },
    "rules.elephant": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Moves two points diagonally, cannot jump, and cannot cross the river."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "斜走两格，不可越子，不可过河。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "斜走兩格，不可越子，不可過河。"
          }
        }
      }
    },
    "rules.general": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Moves one point orthogonally inside the palace. The generals may not face on an open file."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在九宫内直走一格。两将不可在同一直线上照面。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在九宮內直走一格。兩將不可在同一直線上照面。"
          }
        }
      }
    },
    "rules.goal": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Checkmate the opposing general. Red moves first. A side with no legal move loses."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将死对方的将帅。红先走。无合法着法的一方判负。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將死對方的將帥。紅先走。無合法著法的一方判負。"
          }
        }
      }
    },
    "rules.horse": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Moves one orthogonal step then one diagonal step; the first step cannot be blocked."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "先直行一格再斜行一格；第一格不可被蹩马腿。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "先直行一格再斜行一格；第一格不可被蹩馬腿。"
          }
        }
      }
    },
    "rules.notation": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Files are a–i and ranks are 0–9. A move such as b2e2 records its source and destination. The game stores the starting FEN plus this ordered move list for reliable replay and sharing."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "纵线为 a–i，横线为 0–9。像 b2e2 这样的着法记录起点与终点。对局保存起始 FEN 加上这份有序着法表，以便可靠地重演与分享。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "縱線為 a–i，橫線為 0–9。像 b2e2 這樣的著法記錄起點與終點。對局儲存起始 FEN 加上這份有序著法表，以便可靠地重演與分享。"
          }
        }
      }
    },
