    "gameMenu.formatNote": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The saved record uses the starting FEN and ordered UCI moves. Display notation is derived, so games can be replayed and exchanged without depending on the visual theme."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保存的棋谱使用起始 FEN 加有序 UCI 着法，显示用的记谱由此推导，因此对局可以重演和交换，不依赖于视觉主题。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "儲存的棋譜使用起始 FEN 加有序 UCI 著法，顯示用的記譜由此推導，因此對局可以重演與交換，不依賴於視覺主題。"
